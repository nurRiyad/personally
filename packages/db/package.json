{
  "name": "@personally/db",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply personally-local --local --config ../../apps/api/wrangler.jsonc",
    "db:migrate:prod": "wrangler d1 migrations apply personally-production --remote --config ../../apps/api/wrangler.jsonc",
    "db:reset:local": "rm -rf ../../.personally && pnpm db:migrate:local"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260911.1",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.8.2",
    "wrangler": "^4.11.1"
  }
}
